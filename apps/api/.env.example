# ==============================================================================
# Secure Save API Environment Variables
# Copy this file to .env and replace the placeholder values.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/secure-save

# Authentication & JWT Configuration
# Required: Secret string used to sign user session JWTs
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated list of web clients)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,https://securesave.mraks.dev

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# SMTP Email Configuration (Used for sending OTP during Registration & PIN Reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
EMAIL_FROM="Secure Save Vault" <your_email@gmail.com>
