# ==============================================================================
# Secure Save Web App Environment Variables
# Copy this file to .env and replace the placeholder values.
# ==============================================================================

# Base URL for Secure Save API backend
# In development with Vite proxy, '/api' can be used. In production, point to your API deployment.
VITE_API_URL=https://secure-save-blue.vercel.app/api

# Mobile App Sideload Download URLs
VITE_APK_DOWNLOAD_URL=https://github.com/Anjan-Kumar-Sahoo/Secure-Save/releases/download/latest/securesave.apk
VITE_IPA_DOWNLOAD_URL=https://github.com/Anjan-Kumar-Sahoo/Secure-Save/releases/download/latest/securesave.ipa
